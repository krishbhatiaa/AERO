# Copy to .env and edit. NEVER commit .env. Every value below is a placeholder or a safe default.

# ---- mode ------------------------------------------------------------------
ENV=development                 # development | test | production (production enables HSTS)
DEMO_MODE=true                  # runs the built-in SYNTHETIC scenario at startup
REAL_DATA_MODE=false            # true = require real data sources; never fall back to synthetic
DEMO_SEED=7
DEMO_MEMBERS=10

# ---- security --------------------------------------------------------------
AUTH_MODE=none                  # none (local dev only) | api_key | oidc
# API_KEYS entries: name:role:sha256hex  (roles: viewer|analyst|admin)
# generate: python scripts/generate_api_key.py --name admin --role admin
API_KEYS=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
RATE_LIMIT_PER_MINUTE=240
MAX_BODY_BYTES=1000000
AUDIT_LOG_PATH=./var/audit.log
# HMAC key used to sign outgoing webhook payloads (X-EWAI-Signature).
# Leave empty to generate a random per-process key (demo/local use only).
WEBHOOK_SIGNING_SECRET=

# ---- OIDC (when AUTH_MODE=oidc) --------------------------------------------
OIDC_ISSUER_URL=                # e.g. https://login.microsoftonline.com/{tenant}/v2.0
OIDC_CLIENT_ID=
OIDC_JWKS_URL=                  # auto-discovered from issuer if empty
OIDC_AUDIENCE=
OIDC_ROLE_CLAIM=role

# ---- production hardening --------------------------------------------------
HSTS_ENABLED=false
REQUEST_TIMEOUT_SECONDS=30
MAX_CONCURRENT_JOBS=10
LOG_FORMAT=json                 # json | text
LOG_FILE=                       # path to rotating log file (empty = stderr only)

# ---- storage (Zarr/NetCDF; never in PostgreSQL) -----------------------------
STORAGE_BACKEND=local           # local | s3
DATA_PATH=./var/data
S3_ENDPOINT=                    # e.g. http://localhost:9000 for MinIO; empty for AWS
S3_BUCKET=                      # required when STORAGE_BACKEND=s3 (no default on purpose)
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- services ---------------------------------------------------------------
DATABASE_URL=                   # postgresql://user:password@localhost:5432/ewai  (schema: database/schema/001_init.sql)
REDIS_URL=                      # redis://localhost:6379/0  (optional; falls back to an in-memory cache)

# ---- ML ---------------------------------------------------------------------
ML_DEVICE=auto                  # auto | cuda | cpu   (PyTorch is not required by the baselines)
MODEL_BACKEND=baseline          # baseline | onnx | pytorch
MODEL_PATH=./models
LOG_LEVEL=INFO
GIT_SHA=

# ---- ERA5 credentials (use your OWN CDS account; never commit) --------------
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=                       # personal access token from https://cds.climate.copernicus.eu/how-to-api

# ---- MLflow (optional; only needed for a remote tracking server) ------------
MLFLOW_TRACKING_URI=              # empty = local ./var/mlruns
MLFLOW_TRACKING_TOKEN=            # API token for the remote MLflow server; never commit

# ---- docker compose only ----------------------------------------------------
POSTGRES_USER=ewai
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=ewai
MINIO_ROOT_USER=change-me-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret
