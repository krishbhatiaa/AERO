# Keep secrets, VCS metadata, local environments and build artifacts out of image build contexts.
# (Git ignore rules do NOT apply to Docker — this file is what actually protects `docker build`.)
.git
.github
**/.env
**/.env.*
!**/.env.example
**/.cdsapirc
**/__pycache__
**/*.pyc
**/*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
**/*.egg-info/
var/
ne_cache/
mlruns/
models/checkpoints/
**/*.pt
**/*.pth
**/*.ckpt
**/*.safetensors
**/*.onnx
**/*.nc
**/*.grib
**/*.grib2
**/*.grb
**/*.grb2
**/*.log
frontend/node_modules/
frontend/dist/
frontend/.vite/
**/node_modules/
**/dist/
